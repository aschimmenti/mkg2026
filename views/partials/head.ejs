<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · MKG 2026</title>
  <meta name="description" content="Multi-dimensional Knowledge Graphs (MKG) — a full-day Barstuhl workshop at ISWC 2026, Bari, Italy, 25–26 Oct 2026.">
  <link rel="icon" type="image/svg+xml" href="assets/img/favicon.svg">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="MKG 2026">
  <meta property="og:title" content="<%= title %> · MKG 2026">
  <meta property="og:description" content="Multi-dimensional Knowledge Graphs (MKG) — a full-day Barstuhl workshop at ISWC 2026, Bari, Italy, 25–26 Oct 2026.">
  <meta property="og:image" content="https://aschimmenti.github.io/mkg2026/assets/img/preview.png">
  <meta property="og:url" content="https://aschimmenti.github.io/mkg2026/">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %> · MKG 2026">
  <meta name="twitter:description" content="Multi-dimensional Knowledge Graphs (MKG) — a full-day Barstuhl workshop at ISWC 2026, Bari, Italy, 25–26 Oct 2026.">
  <meta name="twitter:image" content="https://aschimmenti.github.io/mkg2026/assets/img/preview.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="assets/css/style.css" rel="stylesheet">
  <script>
    /* Set the theme before first paint to avoid a light/dark flash. */
    (function () {
      try {
        var stored = localStorage.getItem('mkg2026-theme');
        var theme = stored === 'light' || stored === 'dark'
          ? stored
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-bs-theme', theme);
      } catch (e) {}
    })();
  </script>
</head>
<body>
