<%- include('../partials/head', {title: 'Registration & Attendance'}) %>
<%- include('../partials/nav') %>

<main class="container py-5">
  <h1>Registration &amp; Attendance</h1>
  <p class="lead">Pre-conference days (where MKG 2026 sits) are only accessible via one
    of two routes. All fees are <strong>+22% VAT</strong>, EUR only, card only
    (VISA/MasterCard).</p>

  <div class="row g-4 mb-4">
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body">
          <h3 class="card-title h5">Option A &mdash; attending the main conference too</h3>
          <ul>
            <li>Main Conference fee: Academic early <strong>&euro;670</strong>,
              regular early <strong>&euro;810</strong>, student early <strong>&euro;500</strong></li>
            <li>Pre-conference Days add-on: <strong>&euro;250</strong></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body">
          <h3 class="card-title h5">Option B &mdash; workshop day only</h3>
          <ul>
            <li>Pre-conference Days ONLY ticket: <strong>&euro;350</strong></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <table class="table table-bordered">
    <tbody>
      <tr><th scope="row">Early-bird registration</th><td>31 August 2026</td></tr>
      <tr><th scope="row">Cancellation with partial refund (6% fee)</th><td>until 2 September 2026</td></tr>
      <tr><th scope="row">No refunds</th><td>from 3 September 2026</td></tr>
    </tbody>
  </table>

  <p><a href="#" class="btn btn-primary">[TODO: link to ISWC 2026 registration page]</a></p>
</main>

<%- include('../partials/footer') %>
